#include <winres.h>
#include "resource.h"

IDI_APPICON ICON "losscat.ico"

IDR_LICENSE_LOSSCAT   RCDATA "licenses\\losscat.txt"
IDR_LICENSE_MINIAUDIO RCDATA "licenses\\miniaudio.txt"
IDR_LICENSE_TAGLIB    RCDATA "licenses\\taglib.txt"
IDR_LICENSE_ZLIB      RCDATA "licenses\\zlib.txt"
IDR_LICENSE_UTFCPP    RCDATA "licenses\\utfcpp.txt"
IDR_LICENSE_ASIO      RCDATA "licenses\\asio.txt"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,3,0
 PRODUCTVERSION 0,2,3,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "LossCat"
            VALUE "FileVersion", "0.2.3"
            VALUE "CompanyName", "SegCat"
            VALUE "InternalName", "LossCat"
            VALUE "LegalCopyright", "\xA9 2026 SegCat"
            VALUE "OriginalFilename", "LossCat.exe"
            VALUE "ProductName", "LossCat"
            VALUE "ProductVersion", "0.2.3"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
